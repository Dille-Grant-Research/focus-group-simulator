OLLAMA_HOST=192.168.x.x          # IP or hostname of the GPU machine
OLLAMA_PORT=11434                 # Default Ollama port; change only if non-standard
OLLAMA_MODEL=gpt-oss-20b         # Model name as registered in Ollama

ENTRA_TENANT_ID=your-tenant-id-here
ENTRA_CLIENT_ID=your-client-id-here
ENTRA_CLIENT_SECRET=your-client-secret-here

# The redirect URI must be registered in the Entra app by MSUM IT.
# Local dev:  http://localhost:8000/api/v1/auth/callback
# Production: https://your-server.mnstate.edu/api/v1/auth/callback
ENTRA_REDIRECT_URI=https://your-server.mnstate.edu/api/v1/auth/callback

FRONTEND_URL=https://your-server.mnstate.edu

# Random secret used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=replace-with-a-random-hex-string

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=https://your-server.mnstate.edu

DB_PATH=/data/focusgroup.db

MAX_JOBS_PER_HOUR=5
JOB_TIMEOUT_SECONDS=600
LOG_LEVEL=INFO

# NEVER set this to true in production — it disables all authentication.
DEV_AUTH_BYPASS=false
